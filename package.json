{
  "name": "cats-vs-dogs-logic",
  "version": "0.1.0",
  "private": true,
  "description": "Cats vs Dogs — a two-species logic puzzle. One cat and one dog per row, column and region.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "gen:check": "tsx scripts/verify-generator.ts",
    "cap:add:ios": "cap add ios",
    "cap:sync": "npm run build && cap sync",
    "cap:open:ios": "cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/node": "^26.6.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  }
}
